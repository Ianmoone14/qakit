{
  "name": "@qakit/core",
  "version": "0.1.0",
  "description": "QAKit core runtime: config loading and execution context.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@qakit/contracts": "workspace:*",
    "jiti": "^2.7.0",
    "ulid": "^3.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
