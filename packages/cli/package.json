{
  "name": "@qakit/cli",
  "version": "0.1.0",
  "description": "QAKit CLI: init a consumer project, print versions, and upgrade pinned @qakit packages.",
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "restricted"
  },
  "type": "module",
  "bin": {
    "qakit": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@qakit/api": "workspace:*",
    "@qakit/core": "workspace:*",
    "@qakit/playwright": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
